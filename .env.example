# Optional: forward project persistence to the standalone VAD daemon.
# See docs/DAEMON.md
# VAD_DAEMON_URL=http://127.0.0.1:3921
# VAD_USE_DAEMON=true
# VAD_DAEMON_PORT=3921
# VAD_DAEMON_HOST=127.0.0.1
# VAD_DAEMON_TOKEN=

# Dev-only: allow mock LLM responses without real API keys.
# VAD_ALLOW_MOCK_DEV=true

# Optional HTTP proxy for provider API calls.
# HTTPS_PROXY=
# HTTP_PROXY=
