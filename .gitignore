# =============================================================================
# Vibeboard — .gitignore
# =============================================================================

# ----- dependencies -----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ----- Next.js / build -----
.next/
out/
build/
dist/
dist-sidecar/
release/
*.tsbuildinfo
next-env.d.ts

# ----- test / coverage -----
coverage/
.vitest/
vitest.config.ts.timestamp-*

# ----- env & secrets -----
.env
.env.*
!.env.example
!.env*.example
*.pem

# ----- logs & local debug output -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-dev.log
.next-dev.log*
.tsc-out.txt
debug-*.log

# ----- OS junk -----
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ----- IDE / editor -----
.idea/
.vscode/
*.swp
*.swo
*~

# ----- Cursor / local agent tooling -----
.cursor/
.impeccable/
.agents/
.claude/

# ----- Vibeboard local runtime data -----
.vad/
.vad-data/
.tmp/
.tmp-edge-profile/
.tmp-*

# ----- nested sibling repos (have their own .git) -----
Loomic/
open-design/

# ----- deploy / cloud -----
.vercel

# ----- misc local artifacts -----
*.local
*.bak
*.orig
.cache/
